[Unit]
Description=LinkBound private noVNC viewer
Requires=linkbound-display.service
After=linkbound-display.service

[Service]
Type=simple
User=linkbound
Group=linkbound
Environment=HOME=/var/lib/linkbound
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5901
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
