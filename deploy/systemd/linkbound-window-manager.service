[Unit]
Description=LinkBound Openbox window manager
Requires=linkbound-display.service
After=linkbound-display.service

[Service]
Type=simple
User=linkbound
Group=linkbound
Environment=HOME=/var/lib/linkbound
Environment=DISPLAY=:1
ExecStart=/usr/bin/dbus-launch --exit-with-session /usr/bin/openbox --sm-disable
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
