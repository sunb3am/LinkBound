# Copy to /etc/linkbound/app.env; root:linkbound, mode 0640.
LINKBOUND_DATA_DIR=/var/lib/linkbound/data
LINKBOUND_PROFILE_ROOT=/var/lib/linkbound
LINKBOUND_REQUIRE_TAILSCALE_AUTH=true
# Accept any direct tailnet device that the tailnet policy allows to reach Serve.
# The app still rejects requests that do not arrive through the local proxy.
LINKBOUND_ALLOW_TAILNET_DEVICES=true
LINKBOUND_CHROMIUM_SANDBOX=true
LINKBOUND_PILOT_DAILY_CAP=5
LINKBOUND_PILOT_WEEKLY_CAP=20
# Optional narrower mode: set the line above to false and list Tailscale logins.
# LINKBOUND_TAILSCALE_ALLOWED_USERS=[TAILSCALE_LOGIN]
LINKBOUND_ALLOW_LIVE_SENDS=false
# Optional internal API credentials. Leave unset until a client needs one.
# OUTBOUND_API_KEYS=[SERVICE_KEY]
